# ERFtoREMORA baseline reproducer using the REMORA CoupleToERF problem.
# REMORA params come from the CoupleToERF problem directory; ERF params
# come from the RemoraCoupling shear deck.
#
# Requires:
#   REMORA source: Exec/CoupleToERF/inputs
#   ERF source: .Exec_dev/RemoraCoupling/inputs_shear_ERFtoREMORA
#   ERF source: .Exec_dev/RemoraCoupling/input_sounding

FILE = Submodules/REMORA/Exec/CoupleToERF/inputs
FILE = Submodules/ERF/.Exec_dev/RemoraCoupling/inputs_shear_ERFtoREMORA

# Override FPE trap from CoupleToERF/inputs while coupling plumbing is validated.
amrex.fpe_trap_invalid = 0

# Resolve sounding file from ERF checkout location.
erf.input_sounding_file = Submodules/ERF/.Exec_dev/RemoraCoupling/input_sounding

# Driver-owned topology.
# Atmosphere: match ocean horizontal extent from CoupleToERF (1600x1600).
driver.atm.prob_lo     = 0.0 0.0 0.0
driver.atm.prob_hi     = 1600.0 1600.0 1600.0
driver.atm.n_cell      = 16 16 16
driver.atm.is_periodic = 1 1 0

# Ocean: from CoupleToERF/inputs (1600x1600x150m, 16x16x32 cells).
driver.ocn.prob_lo     = 0.0 0.0 -150.0
driver.ocn.prob_hi     = 1600.0 1600.0 0.0
driver.ocn.n_cell      = 16 16 16

driver.synthetic_only = 0
driver.coupling_direction = ERFtoREMORA
# driver.dt_atm sets the coupled step size; erf.fixed_dt and remora.fixed_dt
# must match so each solver takes exactly one step per coupled advance.
driver.dt_atm = 1
driver.atm_substeps_per_ocean_step = 1

max_step = 10

# ERF: shear sounding IC, 1 s timestep matched to driver cadence. This deck
# intentionally does not enable OceanSurf or SST-sensitive bulk coefficients.
erf.fixed_dt = 1
erf.plot_file_1 = erfplt
erf.plot_int_1 = 1

# REMORA: CoupleToERF IC, 1 s timestep matched to driver cadence
remora.fixed_dt = 1
remora.plot_file = remoraplt
remora.plot_int = 1

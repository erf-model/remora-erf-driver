# One-step ERF->cache->REMORA reproducer using the ERF RemoraCoupling shear deck.
# This expects ERF checkout to contain:
#   external-src/ERF/.Exec_dev/RemoraCoupling/inputs_shear_oneway
#   external-src/ERF/.Exec_dev/RemoraCoupling/input_sounding

FILE = external-src/ERF/.Exec_dev/RemoraCoupling/inputs_shear_oneway

# Combined-driver smoke runs should not abort on the first FP invalid in REMORA
# while we are still validating initialization/coupling plumbing.
amrex.fpe_trap_invalid = 0

# Ensure ERF resolves sounding file from ERF checkout location.
erf.input_sounding_file = external-src/ERF/.Exec_dev/RemoraCoupling/input_sounding

# Compatibility overrides for current ERF development parser path.
# The included deck uses `geometry.prob_extent`; this wrapper sets explicit
# bounds so MOST zref checks run against the intended physical domain.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 3200.0 3200.0 1600.0

# Additional safety override for current one-step driver path where ERF may
# still resolve unit-height geometry before the prob_hi override is applied.
erf.most.zref = 0.5

# Driver mode: non-synthetic, coupled one-step path.
driver.synthetic_only = 0
driver.coupled_one_step = 1
driver.atm2ocn_mode = state

# Keep one-step behavior for smoke testing.
max_step = 1

# REMORA minimal setup for one-step apply/evolve.
remora.v = 0
remora.sum_interval = -1
remora.ic_type = analytic
remora.grid_scale_type = constant
remora.flat_bathymetry = true
remora.fixed_dt = 10.0
remora.fixed_ndtfast_ratio = 10
remora.plot_file = remoraplt
remora.plot_int = -1
remora.plot_vars_3d = salt temp x_velocity y_velocity z_velocity
remora.plot_vars_2d = zeta
remora.plotfile_type = amrex

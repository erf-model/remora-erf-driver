# Two-way ERF<->REMORA run with OceanSurf SST feedback active in ERF.
# This deck is intended for sensitivity/reproducer runs where ocean SST should
# materially affect ERF surface fluxes and temperature tendencies.
#
# Requires:
#   REMORA source: Exec/CoupleToERF/inputs
#   ERF source: .Exec_dev/RemoraCoupling/inputs_shear_two_way
#   ERF source: .Exec_dev/RemoraCoupling/input_sounding

FILE = Submodules/REMORA/Exec/CoupleToERF/inputs
FILE = Submodules/ERF/.Exec_dev/RemoraCoupling/inputs_shear_two_way

amrex.fpe_trap_invalid = 0
erf.input_sounding_file = Submodules/ERF/.Exec_dev/RemoraCoupling/input_sounding

# Driver-owned topology (matched horizontal footprint).
driver.atm.prob_lo     = 0.0 0.0 0.0
driver.atm.prob_hi     = 1600.0 1600.0 1600.0
driver.atm.n_cell      = 16 16 16
driver.atm.is_periodic = 1 1 0

driver.ocn.prob_lo     = 0.0 0.0 -150.0
driver.ocn.prob_hi     = 1600.0 1600.0 0.0
driver.ocn.n_cell      = 16 16 16

driver.synthetic_only = 0
driver.coupling_direction = two_way
# driver.dt_atm sets the coupled step size; erf.fixed_dt and remora.fixed_dt
# must match so each solver takes exactly one step per coupled advance.
driver.dt_atm = 1
driver.atm_substeps_per_ocean_step = 1

# Default short run; override at runtime for sensitivity experiments (e.g. max_step=600).
max_step = 10

# ERF: OceanSurf land surface model with bulk transfer coefficients supplied
# by the two-way ERF RemoraCoupling base deck.
erf.fixed_dt = 1
erf.land_surface_model = OceanSurf
erf.is_land = 0
erf.plot_file_1 = erfplt
erf.plot_int_1 = 1

# REMORA: CoupleToERF IC, SST packed into cache each ocean step for ERF OceanSurf injection
remora.fixed_dt = 1
remora.plot_file = remoraplt
remora.plot_int = 1

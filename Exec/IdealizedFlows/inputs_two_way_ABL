# Two-way ABL reproducer
# Merges the ERF ABL case with REMORA CoupleToERF and routes REMORA SST
# back into ERF through OceanSurf.

# Base Decks
FILE = Submodules/REMORA/Exec/CoupleToERF/inputs
FILE = Submodules/ERF/.Exec_dev/RemoraCoupling/inputs_abl

# Sounding File
erf.input_sounding_file = Submodules/ERF/.Exec_dev/RemoraCoupling/input_sounding_GABLS1

# Override FPE trap
amrex.fpe_trap_invalid = 0

# Driver Control
driver.synthetic_only = 0
driver.coupling_direction = two_way
driver.dt_atm = 1.0
driver.atm_substeps_per_ocean_step = 1
max_step = 10

# ERF must use OceanSurf for the run to be physically two-way.
erf.land_surface_model = OceanSurf

# Timing alignment
erf.fixed_dt = 1.0
remora.fixed_dt = 1.0

# Diagnostics
erf.plot_file_1 = erf_abl_plt
erf.plot_int_1 = 1
remora.plot_file = remora_abl_plt
remora.plot_int = 1

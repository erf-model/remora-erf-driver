# Two-way Couette reproducer
# Merges the ERF Couette case with REMORA CoupleToERF and routes REMORA SST
# back into ERF through OceanSurf.

# Base Decks
FILE = Submodules/REMORA/Exec/CoupleToERF/inputs
FILE = Submodules/ERF/.Exec_dev/RemoraCoupling/inputs_couette

# Override FPE trap
amrex.fpe_trap_invalid = 0

# Driver Control
driver.synthetic_only = 0
driver.coupling_direction = two_way
driver.dt_atm = 1.0
driver.atm_substeps_per_ocean_step = 1
max_step = 10

# Route imported REMORA SST through ERF's OceanSurf surface model.
erf.land_surface_model = OceanSurf
erf.is_land = 0

# Timing alignment
erf.fixed_dt = 1.0
remora.fixed_dt = 1.0
remora.bulk_flux_debug = 1

# Diagnostics
erf.plot_file_1 = erf_couette_plt
erf.plot_int_1 = 1
remora.plot_file = remora_couette_plt
remora.plot_int = 1

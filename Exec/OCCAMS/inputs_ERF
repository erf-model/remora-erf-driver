# ------------------  OCCAMS ERF INPUTS  -------------------

# This is a WRFInput real-data case; local ERF examples like WPS_Test use
# prob_name only as a descriptive label, so leave it unset here.
# erf.prob_name = "WPS"

# The coupled driver still requires explicit geometry metadata even when ERF
# initializes from WRF NetCDF files.
erf.prob_lo      = 0.0 0.0 0.0
erf.prob_extent  = 1274000.0 1508000.0 20000.0
erf.n_cell       = 637 754 89
erf.is_periodic  = 0 0 0

amr.max_level        = 0
amr.blocking_factor  = 1
amr.max_grid_size_x  = 128
amr.max_grid_size_y  = 128
amr.max_grid_size_z  = 128

# Real-data initialization from WRF files.
erf.init_type           = "WRFInput"
erf.use_real_bcs        = true
erf.real_width          = 5
erf.real_set_width      = 1
erf.real_extrap_w       = true
erf.rebalance_wrf_input = true
erf.nc_init_file_0      = "/pscratch/sd/k/kehinson/oracle/OCCAMS_for_Seahorce/base_drag_202108/wrfinput_d01"
erf.nc_bdy_file         = "/pscratch/sd/k/kehinson/oracle/OCCAMS_for_Seahorce/base_drag_202108/wrfbdy_d01"
erf.nc_low_file         = "/pscratch/sd/k/kehinson/oracle/OCCAMS_for_Seahorce/base_drag_202108/wrflowinp_d01"

# WRF-derived physics choices retained where ERF has direct support.
# WRF mp_physics=28 has no clean ERF equivalent in this repo; keep a simple
# supported fallback here and record the mismatch in translation_map.tsv.
erf.moisture_model    = "Kessler"
# WRF bl_pbl_physics=1 is YSU. ERF has two implementations: "YSU" is a partial
# port that aborts on unstable conditions ("For now, YSU PBL only supports stable
# conditions", ERF_ComputeDiffusivityYSU.cpp), which this August coastal case hits
# immediately. "YSUNew" is the full port -- same scheme family, no stability or
# zref restriction -- so it is the faithful translation here.
erf.pbl_type          = "YSUNew"
erf.molec_diff_type   = "None"
erf.les_type          = "None"
erf.use_gravity       = true
erf.use_coriolis      = true
erf.coriolis_3d       = true
erf.variable_coriolis = true
erf.has_lat_lon       = true
erf.terrain_type      = StaticFittedMesh

# WRF dynamics/w_damping = 0. Copied directly: the source does not request
# WRF-style vertical-velocity damping, so neither does this deck.
erf.w_damping         = false

# WRF dynamics/damp_opt = 3, zdamp = 5000., dampcoef = 0.2 -- implicit
# gravity-wave damping over the top 5 km. Without it, vertically propagating
# mountain waves reflect off zhi.type = SlipWall at 20 km, and the vertical
# advective CFL passes 1 well before the horizontal one does: ERF's own
# "Anelastic dt" diagnostic (purely advective, ERF_TimestepUtils.H:168-170)
# reports ~5.8-6.6 s against erf.fixed_dt = 10.
#
# ERF's analog is Rayleigh damping on w, which damps toward wbar[k] with a
# sine-squared ramp over rayleigh_zdamp (ERF_MakeMomSources.cpp:486-492,
# ERF_InitRayleigh.cpp:42-51). The reference vectors are zero-filled at
# ERF_InitRayleigh.cpp:29-30 and no input sounding overwrites them on the
# WRFInput path, so wbar = 0 and this damps w toward zero as WRF does.
#
# zdamp and dampcoef carry over exactly. The solve method does not: WRF damps
# implicitly, ERF explicitly. That forces the damping_type choice below.
#
# NOT the default SlowExplicit: that applies the damping in the slow RHS at
# fixed_dt, giving dampcoef*dt = 0.2*10 = 2.0 at the model top, past the ~1.73
# real-axis stability limit of WRF-style RK3. Damping meant to stabilize the
# top of the domain would itself go unstable there.
#
# NOT FastImplicit either: use_Rayleigh_fast_w tests ONLY FastExplicit
# (ERF_MakeMomSources.cpp:92), so under FastImplicit the explicit W source at
# :485-494 still fires on the slow step, while ERF_TI_substep_fun.H:145 also
# hands the substep an implicit W damping that is not gated on
# rayleigh_damp_W. W would be damped twice.
#
# FastExplicit moves W damping into the acoustic substep: dampcoef*dtau =
# 0.2*0.5 = 0.1, one application, WRF's coefficient and layer depth intact.
# It also routes U/V damping to the substep, which is inert here since
# rayleigh_damp_U/V stay false.
erf.rayleigh_damping_type = FastExplicit
erf.rayleigh_damp_W   = true
erf.rayleigh_zdamp    = 5000.0
erf.rayleigh_dampcoef = 0.2

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.average_policy = 1
erf.most.radius         = 0
erf.most.zref           = 10.0
# Without interpolation, MOST snaps zref to the center of whichever cell contains
# the 10 m point (ERF_MOSTAverage.cpp set_k_indices_T), which on this vertical
# grid gives 8.565 m. With interpolation, set_z_positions_T keeps zref at 10.0 and
# interpolates the surface-layer fields to that height instead. Strictly required
# by pbl_type=YSU, which aborts unless zref is exactly 10 m on the terrain-fitted
# path; kept for pbl_type=YSUNew as well because it makes the atmosphere's
# reference height agree with the 10 m REMORA's bulk fluxes assume
# (remora.blk_ZW/ZT/ZQ).
erf.most.use_interpolation = 1
erf.most.z0             = 0.1
erf.most.surf_temp      = 300.0
erf.most.surf_moist     = 0.0

# WRF namelist time_step=10s.
erf.fixed_dt = 10.0

erf.sum_interval = 1
erf.v            = 1
amr.v            = 1

# Print the effective acoustic and vertical-advective CFLs each step
# (ERF_ComputeTimestep.cpp:456-468). The vertical advective CFL is the number
# that matters here: it is what exceeded 1 before the Aug 2026 blowup, and the
# code's own comment at :466 says w-damping is the remedy when it does. Reading
# it directly beats inferring it from the "Anelastic dt would be" line.
# Requires erf.v=1 and substepping active, both true above.
erf.substepping_diag = 1

erf.check_file = occams_erf_chk
erf.check_int  = 8640

erf.plot_file_1 = occams_erf_plt
erf.plot_int_1  = 360
erf.plot_vars_1 = density x_velocity y_velocity z_velocity pressure temp theta qv qc qr pres_hse z_phys

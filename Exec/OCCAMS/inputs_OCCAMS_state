# OCCAMS state-passing two-way run.

FILE = inputs_REMORA
FILE = inputs_ERF

amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024

driver.coupling_direction = two_way
driver.atm2ocn_mode       = state
driver.ocean_time_offset  = 49939200.0

# Per-lane atmos->ocean forcing ownership.
#
# A lane the REMORA deck configures explicitly stays with the deck, and
# inputs_REMORA names netcdf sources for winds, Tair and Pair because it is
# shared with standalone runs. Right there, wrong here: a coupled run wants those
# from ERF, so name them and keep the coupled intent in this wrapper.
#
# Left to inputs_REMORA on purpose: SWrad/LWrad, since this case runs ERF without
# radiation, and Qair/rain, whose ERF packs are disabled upstream. Naming any of
# those "erf" aborts rather than passing a lane ERF never wrote.
driver.atm2ocn_lane_source.Uwind = erf
driver.atm2ocn_lane_source.Vwind = erf
driver.atm2ocn_lane_source.Patm  = erf
driver.atm2ocn_lane_source.Tair  = erf
driver.atm2ocn_lane_source.cloud = erf

max_step = 1
start_datetime = "2021-08-01 00:00:00"

erf.fixed_dt    = 10.0
remora.fixed_dt = 300.0
# Keep the barotropic step at ocean.in's 1 s: see the note in inputs_OCCAMS_flux.
remora.ndtfast  = 300

erf.plot_file_1 = occams_state_erf_plt
erf.check_file  = occams_state_erf_chk

remora.plot_file = occams_state_remora_plt
remora.check_file = occams_state_remora_chk

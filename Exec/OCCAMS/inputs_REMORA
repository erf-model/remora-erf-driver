# ------------------  OCCAMS REMORA INPUTS  -------------------

# Use the least-intrusive supported REMORA problem family for a NetCDF-driven
# coupled case. BlankProblem is recognized by REMORA without pulling in the
# extra analytic setup used by IdealMiniGrid, Upwelling, or CoupleToERF.
remora.prob_name = BlankProblem

# Horizontal extent matched to the WRF atmosphere deck while preserving the
# native ROMS grid counts. Under driver.remap_frame=spherical the two RealBoxes
# no longer have to agree -- overlap is decided from lon_psi/lat_psi against
# ERF's lon/lat corners, not from these numbers -- so this is now only REMORA's
# own internal geometry. Left as-is deliberately: changing it mid-bring-up would
# move REMORA's grid under the coupled case, which is a separate change.
remora.prob_lo     = 0.0 0.0 -5000.0
remora.prob_hi     = 1274000.0 1508000.0 0.0
remora.n_cell      = 563 751 40
remora.is_periodic = 0 0 0

amr.max_grid_size_x = 128
amr.max_grid_size_y = 128
amr.max_grid_size_z = 128

remora.boundary_per_variable = true
remora.bc.temp.type   = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.salt.type   = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.u.type      = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.v.type      = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.w.type      = outflow outflow slipwall outflow
remora.bc.ubar.type   = flather flather slipwall flather
remora.bc.vbar.type   = flather flather slipwall flather
remora.bc.zeta.type   = chapman chapman slipwall chapman
remora.bc.tke.type    = outflow outflow slipwall outflow

# ocean.in DT=15 s, NDTFAST=15: a 1 s barotropic step. The coupled decks override
# fixed_dt and must scale ndtfast with it. See translation_map.tsv (NDTFAST).
remora.fixed_dt            = 15.0
remora.ndtfast = 15

# ocean.in TIME_REF=20200101: the model clock's reference date. REMORA places each
# NetCDF file's times on this clock from the reference date in its units attribute,
# so the 2020-based boundary file and the 1900-based forcing file both line up, and
# driver.ocean_time_offset (DSTART, 578 days) counts from it. Without it the clock
# starts at 0001-01-01 and the offset lands in year 2. See translation_map.tsv.
remora.time_ref = 20200101

remora.sum_interval = 1
remora.v            = 0

remora.check_file = occams_remora_chk
remora.check_int  = 28800

remora.plot_file     = occams_remora_plt
remora.plot_int      = 720
remora.plotfile_type = amrex
remora.plot_vars_3d  = salt temp x_velocity y_velocity z_velocity
remora.plot_vars_2d  = zeta ubar vbar sustr svstr srflux lrflux shflux lhflux rain mask_rho

remora.tracer_horizontal_advection_scheme = "upstream3"
remora.horizontal_mixing_type             = "constant"
remora.visc2                              = 15.0
remora.vertical_mixing_type               = gls

# ocean.in TNU2 == 0.2d0 0.2d0 (m2/s, :335). In ROMS VISC2 and TNU2 are
# independent: visc2 above is momentum only, and tnu2_temp/tnu2_salt default to
# zero (REMORA_DataStruct.H:571-572), so leaving them unset ran this case with
# no horizontal tracer diffusivity at all.
remora.tnu2_temp = 0.2
remora.tnu2_salt = 0.2

# ocean.in AKV_BAK == 1.0d-5 (:367) against a REMORA default of 5.0e-6
# (REMORA_DataStruct.H:1008) -- background vertical viscosity was running 2x
# low. AKT_BAK == 1.0d-6 (:360) happens to equal its default (:1010); set it
# explicitly so the agreement is intentional rather than coincidental.
remora.Akv_bak = 1.0e-5
remora.Akt_bak = 1.0e-6

# ocean.in Zos == 0.5d0, Zob == 0.02d0 (:416-417). Zos feeds the GLS surface
# boundary condition (REMORA_gls.cpp:382) and defaults to 2e-2
# (REMORA_DataStruct.H:933), so it was 25x low under vertical_mixing_type=gls.
# Zob already equals its default (:932); set for the same reason as Akt_bak.
remora.Zos = 0.5
remora.Zob = 0.02

remora.R0    = 1027.0
remora.S0    = 30.0
remora.T0    = 10.0
remora.Tcoef = 1.7e-4
remora.Scoef = 7.6e-4
remora.rho0  = 1025.0

remora.use_coriolis = true
remora.coriolis_type = netcdf

remora.theta_s = 8.0
remora.theta_b = 3.0
remora.tcline  = 100.0

remora.bulk_fluxes = true
remora.wind_type   = "netcdf"
remora.tair_type   = "netcdf"
remora.qair_type   = "constant"
remora.pair_type   = "netcdf"
remora.swrad_type  = "netcdf"
remora.lwrad_type  = "netcdf"
remora.rain_type   = "netcdf"
remora.cloud_type  = "constant"
remora.longwave_down = true
remora.longwave_netcdf_varname = "lwrad_down"
remora.air_humidity = 0.776
remora.qair_is_percent = false
remora.cloud = 0.0
remora.blk_ZQ = 10.0
remora.blk_ZT = 10.0
remora.blk_ZW = 10.0
remora.obcfac = 30.0

# ocean.in TNUDG == 30.0d0 30.0d0, ZNUDG == 0.0d0, M2NUDG == 0.0d0,
# M3NUDG == 30.0d0, all in days (:463-466). All four default to zero in REMORA
# (REMORA_DataStruct.H:725-728), and nudg_coeff is computed as
# 1/(tnudg*86400) guarded on > 0 (:736-742), so with them unset the coefficient
# was identically zero and the orlanski_rad_nudg boundaries above ran as pure
# Orlanski radiation with no nudging at all -- silently, since the guard
# prevents a divide-by-zero rather than reporting one. Units are days on both
# sides, so these copy across directly.
remora.tnudg  = 30.0
remora.znudg  = 0.0
remora.m2nudg = 0.0
remora.m3nudg = 30.0

remora.ic_type        = "netcdf"
#remora.nc_init_file_0 = "/pscratch/sd/k/kehinson/oracle/OCCAMS_for_Seahorce/base_drag_202108/OCCAMS_ini_20210427.nc"
#remora.nc_grid_file_0 = "/pscratch/sd/k/kehinson/oracle/OCCAMS_for_Seahorce/base_drag_202108/oneyear_grd.nc"
remora.nc_init_file_0 = "/global/cfs/cdirs/m4304/jmsexton/OCCAM/pnetcdf_compat/OCCAMS_ini_20210427_64bit.nc"
remora.nc_grid_file_0 = "/global/cfs/cdirs/m4304/jmsexton/OCCAM/pnetcdf_compat/oneyear_grd_64bit.nc"
remora.nc_frc_file    = "/pscratch/sd/k/kehinson/oracle/OCCAMS_for_Seahorce/base_drag_202108/oneyear_forcings.nc"
remora.frc_time_varname = "time"

# Leave climatology nudging and explicit NetCDF boundary history for a later
# pass once the driver-side non-conformal coupling path is stable and the
# absolute BRY/CLM/NUD file wiring has been validated.
remora.nc_bdry_file = "/global/cfs/cdirs/m4304/jmsexton/OCCAM/pnetcdf_compat/OCCAMS_bry_v7_merc_202108_64bit.nc"

#remora.nc_grid_file_0 = "/pscratch/sd/k/kehinson/oracle/OCCAMS_for_Seahorce/base_drag_202108/oneyear_grd.nc"
remora.nc_init_file_0 = "/global/cfs/cdirs/m4304/jmsexton/OCCAM/pnetcdf_compat/OCCAMS_ini_20210427_64bit.nc"
remora.nc_grid_file_0 = "/global/cfs/cdirs/m4304/jmsexton/OCCAM/pnetcdf_compat/oneyear_grd_64bit.nc"
remora.nc_frc_file    = "/pscratch/sd/k/kehinson/oracle/OCCAMS_for_Seahorce/base_drag_202108/oneyear_forcings.nc"

# Leave climatology nudging and explicit NetCDF boundary history for a later
# pass once the driver-side non-conformal coupling path is stable and the
# absolute BRY/CLM/NUD file wiring has been validated.
remora.nc_bdry_file = "/global/cfs/cdirs/m4304/jmsexton/OCCAM/pnetcdf_compat/OCCAMS_bry_v7_merc_202108_64bit.nc"
# ------------------  OCCAMS REMORA INPUTS  -------------------

# Use the least-intrusive supported REMORA problem family for a NetCDF-driven
# coupled case. BlankProblem is recognized by REMORA without pulling in the
# extra analytic setup used by IdealMiniGrid, Upwelling, or CoupleToERF.
remora.prob_name = BlankProblem

# Use the same projected horizontal extent as the WRF atmosphere deck while
# preserving the native ROMS grid counts. This allows the mapping branch to
# exercise non-conformal remapping instead of failing the old integer-ratio
# sanity checks in the top-level driver.
remora.prob_lo     = 0.0 0.0 -5000.0
remora.prob_hi     = 1274000.0 1508000.0 0.0
remora.n_cell      = 565 753 40
remora.is_periodic = 0 0 0

amr.max_grid_size_x = 128
amr.max_grid_size_y = 128
amr.max_grid_size_z = 128

remora.boundary_per_variable = true
remora.bc.temp.type   = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.salt.type   = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.scalar.type = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.u.type      = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.v.type      = orlanski_rad_nudg orlanski_rad_nudg slipwall orlanski_rad_nudg
remora.bc.w.type      = outflow outflow slipwall outflow
remora.bc.ubar.type   = flather flather slipwall flather
remora.bc.vbar.type   = flather flather slipwall flather
remora.bc.zeta.type   = chapman chapman slipwall chapman
remora.bc.tke.type    = outflow outflow slipwall outflow

remora.fixed_dt            = 15.0
remora.fixed_ndtfast_ratio = 15

remora.sum_interval = 1
remora.v            = 0

remora.check_file = occams_remora_chk
remora.check_int  = 28800

remora.plot_file     = occams_remora_plt
remora.plot_int      = 720
remora.plotfile_type = amrex
remora.plot_vars_3d  = salt temp x_velocity y_velocity z_velocity
remora.plot_vars_2d  = zeta ubar vbar sustr svstr srflx lrflx shflx lhflx rain

remora.flat_bathymetry                    = false
remora.tracer_horizontal_advection_scheme = "upstream3"
remora.horizontal_mixing_type             = "constant"
remora.visc2                              = 15.0
remora.vertical_mixing_type               = gls

remora.R0    = 1027.0
remora.S0    = 30.0
remora.T0    = 10.0
remora.Tcoef = 1.7e-4
remora.Scoef = 7.6e-4
remora.rho0  = 1025.0

remora.use_coriolis = true
remora.coriolis_type = netcdf

remora.theta_s = 8.0
remora.theta_b = 3.0
remora.tcline  = 100.0

remora.bulk_fluxes = true
remora.wind_type   = "netcdf"
remora.tair_type   = "netcdf"
remora.qair_type   = "constant"
remora.pair_type   = "netcdf"
remora.swrad_type  = "netcdf"
remora.lwrad_type  = "netcdf"
remora.rain_type   = "netcdf"
remora.cloud_type  = "constant"
remora.longwave_down = true
remora.longwave_netcdf_varname = "lwrad_down"
remora.air_humidity = 0.776
remora.qair_is_percent = false
remora.cloud = 0.0
remora.blk_ZQ = 10.0
remora.blk_ZT = 10.0
remora.blk_ZW = 10.0
remora.obcfac = 30.0

remora.ic_type        = "netcdf"

# ------------------  INPUTS TO MAIN PROGRAM  -------------------
#
# ERF side of the coupled upwelling case.  This is set up to reproduce the
# standalone configuration validated against Perlin et al. (2007),
# ERF/.Exec_dev/RemoraCoupling/inputs_oneway: same physics, same closure
# constants, same idealized 1 C/day cooling, radiation off.  Every setting
# that affects the solution is matched, so with coupling_direction =
# ERFtoREMORA (the atmosphere receives no SST back) the vertical profiles
# here should reproduce the standalone ones.
#
# One deliberate difference remains, which does not change the answer: the
# full 50 km x 20 km domain at 1 km resolution.  The standalone deck narrows
# the alongshore extent to 5 km because the uncoupled problem is
# alongshore-uniform; the solution is identical in y, so this only changes the
# domain decomposition.
#
# !! REQUIRES an ERF submodule containing erf-model/ERF #4229, #4235, #4236,
# !! #4238, #4246 and #4248.  The taper, alpha and Perlin07 inputs below do not
# !! exist in older ERF and ParmParse ignores unknown keys SILENTLY -- the run
# !! would complete but use the untapered NN09 length scale with alpha = 0.23,
# !! no moisture diffusion and no radiative cooling, which does not reproduce
# !! the validated result.

erf.moisture_model = MoistNoCondensation

# Default without landmask is set here to sea
erf.is_land = 0

# PROBLEM SIZE & GEOMETRY
erf.prob_lo          = 0.0 0.0 0.0
erf.prob_hi          = 50000 20000 9000.
erf.n_cell           = 50    20   48

amr.blocking_factor_x = 1
amr.blocking_factor_y = 1
amr.blocking_factor_z = 1

amr.no_box_split_dir = 2

# Periodic in N/S direction
erf.is_periodic      = 0 1 0

xlo.type = "Outflow"
xhi.type = "Outflow"

zlo.type = "surface_layer"
erf.surface_layer.flux_type = "bulk_coeff"

# Constant exchange coefficients.  Perlin et al. use the stability-dependent
# scheme of Louis (1979); with these values the standalone case gives a surface
# stress of 0.19 N/m2 against their 0.14 and a mixed layer about 0.5 K warmer.
erf.most.Cd  = 0.0014 # ustar
erf.most.Ch  = 0.0012 # theta flux
erf.most.Cq  = 0.0012 # qv    flux

# With coupling_direction = ERFtoREMORA the atmosphere receives no SST back,
# so this fixed value is what the surface layer sees throughout -- which is
# exactly the "uncoupled" control of Perlin et al.
erf.most.surf_temp  = 287.15
# NOTE: with erf.is_land = 0 the surface mixing ratio is overwritten every step
# with the saturation value at surf_temp, so surf_moist has no effect here.
erf.most.surf_moist = .00802
erf.most.z0     = 0.1
# zref lowered from 25 m to the first cell centre, matching the standalone case.
erf.most.zref   = 10.0

# The MYNN length-scale taper below needs a diagnosed boundary layer height.
erf.most.pblh_calc = MYNN25

zhi.type = "SlipWall"

# TIME STEP CONTROL
# erf.fixed_dt is set in the driver deck (inputs_oneway / inputs_twoway) and
# must be 3.0 to match the standalone case.  fixed_mri_dt_ratio must be set
# explicitly: it defaults to 0, which means the acoustic substep count is
# chosen from the CFL instead and will not match.
erf.substepping_type   = Implicit
erf.fixed_mri_dt_ratio = 6

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1200    # timesteps between computing mass
erf.v              = 0       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# PLOTFILES
# NOTE: "Kmv"/"Khv" are stored as rho*K (kg/m/s); "nut" is the eddy viscosity
# in m2/s.  Compare against Fig. 8a of Perlin et al. using nut, not Kmv.
erf.plot_vars_1     = density x_velocity y_velocity z_velocity pressure temp theta pres_hse z_phys nut Kmv Khv Lturb pblh KE qv

# SOLVER CHOICE
# Stated explicitly rather than left to the defaults, so that the coupled and
# standalone runs use the same advection.
erf.dycore_horiz_adv_type    = Upwind_3rd
erf.dycore_vert_adv_type     = Upwind_3rd
erf.dryscal_horiz_adv_type   = Upwind_3rd_SL
erf.dryscal_vert_adv_type    = Upwind_3rd_SL
erf.moistscal_horiz_adv_type = Upwind_3rd_SL
erf.moistscal_vert_adv_type  = Upwind_3rd_SL

erf.use_gravity = true

erf.les_type          = None
erf.molec_diff_type   = None
erf.pbl_type          = MYNN25

# --- Turbulence closure -----------------------------------------------------
# Three departures from ERF's MYNN defaults, all needed to reproduce the
# Perlin et al. profiles.  See the validation section of the coupling paper.
#
# 1. Mellor-Yamada (1982) closure constants rather than Nakanishi-Niino; this
#    is the set COAMPS uses.  C2/C3/C5 are NN09 extensions and are zeroed so
#    the stability functions reduce to the MY82 form.
erf.pbl_mynn_A1 = 0.92
erf.pbl_mynn_A2 = 0.74
erf.pbl_mynn_B1 = 16.6
erf.pbl_mynn_B2 = 10.1
erf.pbl_mynn_C1 = 0.08
erf.pbl_mynn_C2 = 0.0
erf.pbl_mynn_C3 = 0.0
erf.pbl_mynn_C5 = 0.0

# 2. The MY82 coefficient on the ABL-depth length scale, not NN09's 0.23.
erf.pbl_mynn_Lt_alpha = 0.10

# 3. Boundary-layer-depth taper, l_T -> l_T (1 - z/h)^n.  Without it the master
#    length scale saturates and stays flat to the inversion, giving a
#    flat-topped eddy viscosity.  n = 1.35 was calibrated against their Fig. 8a
#    and is not independently derived.
erf.pbl_mynn_Lt_taper_exp = 1.35

# From ABL/inputs_GABLS1_mynn25
prob.KE_0            = 0.4 # [m2/s2]
prob.KE_decay_height = 250. # [m]
prob.KE_decay_order  = 3

erf.use_coriolis = true
erf.coriolis_3d = false
erf.abl_driver_type = "GeostrophicWind"
erf.latitude = 42
erf.abl_geo_wind = 0.0 -15.0 0.0
erf.rotational_time_period = 86164.0900027328

erf.add_custom_rhotheta_forcing = true
erf.custom_forcing_uses_primitive_vars = true

erf.terrain_type = None
erf.terrain_z_levels = 0.000000 20.000000 40.599936 61.817805 83.672143 106.182041 129.367164 153.247767 177.844712 203.179487 229.274225 256.151722 283.835459 312.349619 341.719113 371.969599 403.127503 435.220045 468.275261 502.322028 537.390090 573.510082 610.713559 649.033022 688.501947 729.154814 771.027137 814.155497 858.577570 904.332165 951.459251 1000.000000 1048.540749 1108.961213 1184.168798 1277.782458 1394.306840 1539.349044 1719.888436 1944.612489 2224.334823 2572.515549 3005.908967 3545.369770 4216.856567 5052.680999 6093.062558 7388.063932 9000.000000

# PROBLEM PARAMETERS (optional)
# prob.rho_0 / prob.T_0 are deliberately not set: they only reach base_parms,
# which the constant-density and Uniform HSE paths read.  With
# init_type = input_sounding the base state comes from erf_init_dens_hse_dry
# and the sounding, so they have no effect.
# Perlin07 gives the KE_0 / KE_decay_* initial TKE profile and dispatches the
# uniform rhotheta tendency used for the radiative cooling below.
erf.prob_name = Perlin07

# Perlin et al. apply a uniform 1 C/day cooling as a stand-in for the radiative
# and large-scale tendencies their idealized domain omits.  Radiation is off
# (see below) so this supplies it, exactly as in the standalone deck.
# -1.1574074074e-5 K/s = -1 K/day.
prob.advection_heating_rate = -1.1574074074e-5

erf.rayleigh_damping_type = SlowExplicit
erf.rayleigh_zdamp    = 1000.0
erf.rayleigh_dampcoef = 0.2

erf.rayleigh_damp_U = true
erf.rayleigh_damp_V = true
erf.rayleigh_damp_W = true
erf.rayleigh_damp_T = true

# INITIALIZATION WITH ATM DATA
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = input_sounding_for_ERF

# --- Radiation --------------------------------------------------------------
# Off, so that prob.advection_heating_rate above is the only thermal forcing
# and this run reproduces the standalone Perlin et al. comparison.  To put
# interactive radiation back, set erf.radiation_model = RRTMGP, uncomment the
# block below, and zero prob.advection_heating_rate -- running both would
# double-count the cooling.
#
# Note when re-enabling: rad_t_sfc = 300 K is inconsistent with the 287.15 K
# sea surface prescribed above and will bias the downwelling longwave; 287.15
# is the physically consistent value.
erf.radiation_model        = None


# ------------------  INPUTS TO MAIN PROGRAM  -------------------

erf.moisture_model = MoistNoCondensation

# Default without landmask is set here to sea
erf.is_land = 0

# PROBLEM SIZE & GEOMETRY
erf.prob_lo          = 0.0 0.0 0.0
erf.prob_hi          = 50000 20000 9000.
erf.n_cell           = 50    20   48

amr.blocking_factor_x = 1
amr.blocking_factor_y = 1
amr.blocking_factor_z = 1

# Periodic in N/S direction
erf.is_periodic      = 0 1 0

xlo.type = "Outflow"
xhi.type = "Outflow"

zlo.type = "surface_layer"
erf.surface_layer.flux_type = "bulk_coeff"

erf.most.Cd  = 0.0014 # ustar
erf.most.Ch  = 0.0012 # theta flux
erf.most.Cq  = 0.0012 # qv    flux

erf.most.surf_temp  = 287.15
erf.most.surf_moist = .00802
erf.most.z0     = 0.1
erf.most.zref   = 25.0

zhi.type = "SlipWall"

# TIME STEP CONTROL
erf.substepping_type = Implicit

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1200    # timesteps between computing mass
erf.v              = 0       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# PLOTFILES
erf.plot_vars_1     = density x_velocity y_velocity z_velocity pressure temp theta pres_hse z_phys Kmv KE qv

# SOLVER CHOICE
erf.use_gravity = true

erf.les_type          = None
erf.molec_diff_type   = None
erf.pbl_type          = MYNN25


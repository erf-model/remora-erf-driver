# ------------------  INPUTS TO MAIN PROGRAM  -------------------

remora.prob_name = UpwellingCoupling

# PROBLEM SIZE & GEOMETRY
remora.prob_lo     =      0.     0.    -300.
remora.prob_hi     =  50000. 20000.       0.

remora.n_cell           =  50     20      40
remora.max_grid_size_z = 1024
amr.max_grid_size_z = 1024
remora.is_periodic = 0 1 0

#                        West         South    East      North
remora.bc.temp.type   =  outflow periodic slipwall  periodic
remora.bc.salt.type   =  outflow periodic slipwall  periodic
remora.bc.u.type      =  outflow periodic slipwall  periodic
remora.bc.v.type      =  outflow periodic slipwall  periodic
remora.bc.w.type      =  outflow periodic slipwall  periodic
remora.bc.ubar.type   =  outflow periodic slipwall  periodic
remora.bc.vbar.type   =  outflow periodic slipwall  periodic
remora.bc.zeta.type   =  outflow      periodic slipwall  periodic
remora.bc.tke.type    =  outflow      periodic slipwall  periodic
remora.boundary_per_variable = true

remora.ndtfast  = 30 # Ratio of baroclinic to barotropic time step

# DIAGNOSTICS & VERBOSITY
remora.sum_interval  = 1       # timesteps between integrated/max quantities, if remora.v > 0
remora.v             = 0       # verbosity in REMORA.cpp (0: none, 1: integrated quantities, etc, 2: print boxes)

# PLOTFILES
remora.plot_vars_3d  = salt temp x_velocity y_velocity z_velocity
remora.plot_vars_2d  = h sustr svstr stflux_temp srflux shflux lrflux lhflux
remora.plotfile_type = amrex

# SOLVER CHOICE
remora.tracer_horizontal_advection_scheme = "upstream3" # upstream3 or centered4

remora.vertical_mixing_type=gls
# To turn GLS into Mellor-Yamada 2.5
#remora.gls_P = 0.0
#remora.gls_M = 1.0
#remora.gls_N = 1.0
#remora.gls_Kmin = 5.0e-6
#remora.gls_Pmin = 5.0e-6
#remora.gls_cmu0 = 0.5544
#remora.gls_c1 = 0.9
#remora.gls_c2 = 0.52
#remora.gls_c3m = 2.5
#remora.gls_c3p = 1.0
#remora.sigk = 1.96
#remora.sigp = 1.96

# Linear EOS parameters
remora.R0    = 1027.0  # background density value (Kg/m3) used in Linear Equation of State
remora.S0    = 50.0    # background salinity (nondimensional) constant
remora.T0    = 20.0    # background potential temperature (Celsius) constant
remora.Tcoef = 1.7e-4  # linear equation of state parameter (1/Celsius)
remora.Scoef = 0.0     # linear equation of state parameter (nondimensional)
remora.rho0  = 1025.0  # Mean density (Kg/m3) used when Boussinesq approx is inferred

remora.tcline = 25.0

# Coriolis parameters
remora.use_coriolis = true
remora.coriolis_type = beta_plane
remora.coriolis_f0 = 9.758755868e-05
remora.coriolis_beta = 0.0

remora.bulk_fluxes = 1

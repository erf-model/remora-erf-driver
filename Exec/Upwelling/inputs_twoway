# Two-way ERF<->REMORA run with OceanSurf SST feedback active in ERF.
#
# Coastal idealization target:
#   - horizontal domain: 50 km x 20 km
#   - atmosphere: 47 levels to 9 km, 31 levels below 1 km
#   - ocean: 40 levels, bottom slopes from 10 m at the coast to ~300 m offshore
#   - alongshore direction periodic, cross-shore direction open/radiative in ERF
#
# Important:
#   This wrapper only sets the coupled domain and solver cadence.
#   The vertical temperature/moisture/salinity profiles and the sloping
#   bathymetry must be edited in the imported ERF/REMORA base decks.
#
# Requires:
#   REMORA source: ./inputs_REMORA
#   ERF source: ./inputs_ERF
#   ERF source: ./input_sounding_for_ERF

FILE = inputs_REMORA
FILE = inputs_ERF

amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024

erf.input_sounding_file = input_sounding_for_ERF

driver.synthetic_only = 0
driver.coupling_direction = two_way
#driver.coupling_direction = ERFtoREMORA

driver.atm2ocn_mode         = flux

## driver.dt_atm sets the coupled step size; erf.fixed_dt and remora.fixed_dt
## must match so each solver takes exactly one step per coupled advance.
driver.erf_dt = 3
driver.atm_substeps_per_ocean_step = 100

# 1 (REMORA) step at 300s/step = 5 minutes ... 72 hours = 72*60=4320 minutes = 864 steps
max_step = 864
start_datetime         = "2025-06-25 11:00:00" # 11am UTC = 4am PDT, which is local time for Oregon summer

erf.fixed_dt = 3
remora.fixed_dt = 300

# ERF: OceanSurf land surface model with bulk transfer coefficients supplied
# by the two-way ERF RemoraCoupling base deck.
erf.land_surface_model = OceanSurf
erf.is_land = 0

erf.plot_file_1 = erfplt
erf.plot_int_1 = 2000

erf.check_file = erfchk
erf.check_int = 2000

# Set flat_bathymetry=false in the REMORA deck and provide the coastal slope there.
remora.flat_bathymetry = false

remora.plot_file = remoraplt
remora.plot_int = 20

remora.check_file = remorachk
remora.check_int = 20
